# =============================================================================
# Compatibility Shapes
# =============================================================================

ord:ApiCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass ord:ApiCompatibility ;
    sh:name "API Compatibility"@en ;
    sh:description "Declares that an API resource is compatible with an abstract API interface contract."@en ;
    sh:property [
        sh:path ord:compatibleWith ;
        sh:name "Compatible With"@en ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:severity sh:Violation
    ] ;
    sh:property ord:EntityTypePropertyShape ;
    sh:property ord:TagPropertyShape .

ord:EventCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass ord:EventCompatibility ;
    sh:name "Event Compatibility"@en ;
    sh:description "Declares that an event resource is compatible with an abstract event interface contract."@en ;
    sh:property [
        sh:path ord:compatibleWith ;
        sh:name "Compatible With"@en ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:severity sh:Violation
    ] ;
    sh:property ord:EntityTypePropertyShape ;
    sh:property ord:TagPropertyShape .

# =============================================================================
# Tombstone Shape
# =============================================================================

ord:TombstoneShape
    a sh:NodeShape ;
    sh:targetClass ord:Tombstone ;
    sh:name "Tombstone"@en ;
    sh:description "A tombstone indicates that a previously published ORD resource or taxonomy entity has been removed or decommissioned."@en ;
    sh:property [
        sh:path ord:removedResource ;
        sh:name "Removed Resource"@en ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:severity sh:Violation
    ] ;
    sh:property ord:RemovedDatePropertyShape ;
    sh:property ord:SuccessorPropertyShape ;
    sh:property ord:DescriptionPropertyShape .

# =============================================================================
# Transitional Warning Shapes
# These detect old/generated string-style values where normalized KG values
# should be SKOS concepts.
# =============================================================================

ord:StringIndustryWarningShape
    a sh:NodeShape ;
    sh:targetSubjectsOf ord:industry ;
    sh:property [
        sh:path ord:industry ;
        sh:not [
            sh:datatype xsd:string
        ] ;
        sh:severity sh:Warning ;
        sh:message "ord:industry should be represented as a SKOS concept IRI in normalized RDF, not as a string literal."@en
    ] .

ord:StringLineOfBusinessWarningShape
    a sh:NodeShape ;
    sh:targetSubjectsOf ord:lineOfBusiness ;
    sh:property [
        sh:path ord:lineOfBusiness ;
        sh:not [
            sh:datatype xsd:string
        ] ;
        sh:severity sh:Warning ;
        sh:message "ord:lineOfBusiness should be represented as a SKOS concept IRI in normalized RDF, not as a string literal."@en
    ] .

ord:StringPolicyLevelWarningShape
    a sh:NodeShape ;
    sh:targetSubjectsOf ord:policyLevel ;
    sh:property [
        sh:path ord:policyLevel ;
        sh:not [
            sh:datatype xsd:string
        ] ;
        sh:severity sh:Warning ;
        sh:message "ord:policyLevel should be represented as a SKOS concept IRI in normalized RDF, not as a string literal."@en
    ] .

ord:StringVisibilityWarningShape
    a sh:NodeShape ;
    sh:targetSubjectsOf ord:visibility ;
    sh:property [
        sh:path ord:visibility ;
        sh:not [
            sh:datatype xsd:string
        ] ;
        sh:severity sh:Warning ;
        sh:message "ord:visibility should be represented as a SKOS concept IRI in normalized RDF, not as a string literal."@en
    ] .

ord:StringReleaseStatusWarningShape
    a sh:NodeShape ;
    sh:targetSubjectsOf ord:releaseStatus ;
    sh:property [
        sh:path ord:releaseStatus ;
        sh:not [
            sh:datatype xsd:string
        ] ;
        sh:severity sh:Warning ;
        sh:message "ord:releaseStatus should be represented as a SKOS concept IRI in normalized RDF, not as a string literal."@en
    ] .

