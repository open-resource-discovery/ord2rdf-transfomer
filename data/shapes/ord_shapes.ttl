    sh:property ord:ChangelogEntryPropertyShape ;
    sh:property ord:RequiredOrdIdPropertyShape ;
    sh:property ord:DescriptionPropertyShape .

ord:ConsumptionBundleShape
    a sh:NodeShape ;
    sh:targetClass ord:ConsumptionBundle ;
    sh:name "Consumption Bundle"@en ;
    sh:description "A collection of resources grouped together for consumption."@en ;
