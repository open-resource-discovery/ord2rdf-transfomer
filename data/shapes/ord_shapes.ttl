        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ord:value ;
        sh:name "Value"@en ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:minLength 1 ;
        sh:severity sh:Violation
    ] .

ord:FileShape
