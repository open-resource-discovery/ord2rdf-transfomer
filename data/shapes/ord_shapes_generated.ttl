@prefix ord: <https://open-resource-discovery.org/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ord:AgentShape a sh:NodeShape ;
    sh:description "An AI-powered autonomous system that can perform tasks, make decisions, and interact with users or other systems to achieve business goals." ;
    sh:name "Agent",
        "AgentShape" ;
    sh:property [ sh:description "Mapping between API models and conceptual entity types." ;
            sh:name "Entity Type Mapping" ;
            sh:path ord:entityTypeMapping ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "short_description" ;
            sh:path ord:shortDescription ],
        [ sh:description "Entity type related to another entity type or resource." ;
            sh:name "Related Entity Type" ;
            sh:path ord:relatedEntityType ],
        [ sh:datatype xsd:boolean ;
            sh:description "Defines whether the resource's extension information is extensible." ;
            sh:name "Extensible" ;
            sh:path ord:extensible ],
        [ sh:description "Optional semantic type of a relationship." ;
            sh:name "Relation Type" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:relationType ],
        [ sh:description "Relates an ORD entity to another concept or resource." ;
            sh:name "Related" ;
            sh:path ord:related ],
        [ sh:description "Policy or compliance level that the described ORD document, package, or resource needs to comply with." ;
            sh:name "Policy Level" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:policyLevel ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "responsible" ;
            sh:path ord:responsible ],
        [ sh:datatype xsd:dateTime ;
            sh:description "RFC 3339 date-time on which the ORD resource or taxonomy entity was tombstoned or removed." ;
            sh:name "Removed Date" ;
            sh:path ord:removedDate ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "min_system_version" ;
            sh:path ord:minSystemVersion ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title." ;
            sh:name "Title" ;
            sh:path ord:title ],
        [ sh:description "Declares compatibility with another resource, interface, or abstract contract." ;
            sh:name "Compatible With" ;
            sh:path ord:compatibleWith ],
        [ sh:description "Machine-readable resource definition associated with an ORD resource." ;
            sh:name "Resource Definition" ;
            sh:path ord:resourceDefinition ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "local_id" ;
            sh:path ord:localId ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether the entity is disabled." ;
            sh:name "Disabled" ;
            sh:path ord:disabled ],
        [ sh:datatype xsd:string ;
            sh:description "ORD ID of a referenced related resource." ;
            sh:name "Related ORD ID" ;
            sh:path ord:relatedOrdId ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "release_status" ;
            sh:nodeKind sh:IRI ;
            sh:path ord:releaseStatus ],
        [ sh:description "Vendor responsible for or associated with the described ORD entity." ;
            sh:name "Vendor" ;
            sh:path ord:vendor ],
        [ sh:description "Line-of-business classification associated with an ORD entity. In normalized RDF, values should be SKOS concepts from ord:LineOfBusinessConceptScheme or a compatible extension scheme." ;
            sh:name "Line of Business" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:lineOfBusiness ],
        [ sh:description "Entity type that the concept or resource is related to." ;
            sh:name "Entity Type" ;
            sh:path ord:entityType ],
        [ sh:description "Package this ORD resource is part of." ;
            sh:name "Part of Package" ;
            sh:path ord:partOfPackage ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed human-readable description." ;
            sh:name "Description" ;
            sh:path ord:description ],
        [ sh:description "Visibility or exposure level of an ORD entity." ;
            sh:name "Visibility" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:visibility ],
        [ sh:description "Key-value metadata label attached to ORD resources." ;
            sh:name "Label" ;
            sh:path ord:label ],
        [ sh:description "Usage classification of a resource." ;
            sh:name "Usage" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:usage ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:name "disabled" ;
            sh:path ord:disabled ],
        [ sh:datatype xsd:string ;
            sh:description "Additional hint intended to support AI-assisted interpretation or discovery." ;
            sh:name "AI Hint" ;
            sh:path ord:aiHint ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "description" ;
            sh:path ord:description ],
        [ sh:datatype xsd:string ;
            sh:description "ORD ID of an integration dependency associated with this agent." ;
            sh:name "Integration Dependency" ;
            sh:path ord:integrationDependency ],
        [ sh:description "Release lifecycle status of an ORD entity." ;
            sh:name "Release Status" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:releaseStatus ],
        [ sh:datatype xsd:string ;
            sh:description "Minimum system version from which a resource is available." ;
            sh:name "Minimum System Version" ;
            sh:path ord:minSystemVersion ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "deprecation_date" ;
            sh:path ord:deprecationDate ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates that the described resource is abstract or interface-only." ;
            sh:name "Abstract" ;
            sh:path ord:abstract ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "sunset_date" ;
            sh:path ord:sunsetDate ],
        [ sh:description "Industry classification associated with an ORD entity. In normalized RDF, values should be SKOS concepts from ord:IndustryConceptScheme or a compatible extension scheme." ;
            sh:name "Industry" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:industry ],
        [ sh:name "line_of_business" ;
            sh:nodeKind sh:IRI ;
            sh:path ord:lineOfBusiness ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "version" ;
            sh:path ord:version ],
        [ sh:description "Consumption bundle reference that this resource is part of." ;
            sh:name "Part of Consumption Bundle" ;
            sh:path ord:partOfConsumptionBundle ],
        [ sh:class ord:RelatedEntityType ;
            sh:name "related_entity_types" ;
            sh:path ord:relatedEntityType ],
        [ sh:description "Successor resource or entity." ;
            sh:name "Successor" ;
            sh:path ord:successor ],
        [ sh:description "Label used to classify or identify documentation." ;
            sh:name "Documentation Label" ;
            sh:path ord:documentationLabel ],
        [ sh:description "Contains changelog entries that summarize changes, especially with regard to version and release status." ;
            sh:name "Changelog Entry" ;
            sh:path ord:changelogEntry ],
        [ sh:datatype xsd:string ;
            sh:description "Local identifier as known by the described system." ;
            sh:name "Local ID" ;
            sh:path ord:localId ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "policy_level" ;
            sh:path ord:policyLevel ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "title" ;
            sh:path ord:title ],
        [ sh:datatype xsd:dateTime ;
            sh:description "RFC 3339 date-time indicating when an ORD resource or entity is planned to be sunset." ;
            sh:name "Sunset Date" ;
            sh:path ord:sunsetDate ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "visibility" ;
            sh:nodeKind sh:IRI ;
            sh:path ord:visibility ],
        [ sh:description "Group this ORD entity is part of." ;
            sh:name "Part of Group" ;
            sh:path ord:partOfGroup ],
        [ sh:datatype xsd:string ;
            sh:description "Deprecated since ORD spec v1.9.9. Custom policy level specification identifier. Use ord:policyLevel with a SKOS concept instead." ;
            sh:name "Custom Policy Level" ;
            sh:path ord:customPolicyLevel ],
        [ sh:datatype xsd:string ;
            sh:description "Person, team, or organizational unit responsible for this resource." ;
            sh:name "Responsible" ;
            sh:path ord:responsible ],
        [ sh:datatype xsd:string ;
            sh:description "Custom type identifier used when the link or credential-exchange type is 'custom'." ;
            sh:name "Custom Type" ;
            sh:path ord:customType ],
        [ sh:class ord:ConsumptionBundleReference ;
            sh:name "part_of_consumption_bundles" ;
            sh:path ord:partOfConsumptionBundle ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "ai_hint" ;
            sh:path ord:aiHint ],
        [ sh:datatype xsd:dateTime ;
            sh:description "ISO 8601 date-time after which this resource is considered deprecated." ;
            sh:name "Deprecation Date" ;
            sh:path ord:deprecationDate ],
        [ sh:datatype xsd:string ;
            sh:description "Country code according to ISO 3166-1 alpha-2. Countries assigned to a package are inherited by contained resources." ;
            sh:name "Country" ;
            sh:path ord:country ],
        [ sh:datatype xsd:string ;
            sh:description "Plain-text short description." ;
            sh:name "Short Description" ;
            sh:path ord:shortDescription ],
        [ sh:description "Typed ORD ID references to related capabilities." ;
            sh:name "Related Capabilities" ;
            sh:path ord:relatedCapabilities ],
        [ sh:description "Semantically typed link specific to ORD resources." ;
            sh:name "Resource Link" ;
            sh:path ord:resourceLink ],
        [ sh:datatype xsd:string ;
            sh:description "Full description of a custom implementation standard." ;
            sh:name "Implementation Standard Description" ;
            sh:path ord:standardDescription ],
        [ sh:class ord:Link ;
            sh:name "links" ;
            sh:path ord:link ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Recommended date-time indicating when the last change to the resource, including its definitions, happened." ;
            sh:name "Last Update" ;
            sh:path ord:lastUpdate ],
        [ sh:description "Externally standardized API contract, sub-protocol, or protocol variant implemented by a resource." ;
            sh:name "Implementation Standard" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:implementationStandard ],
        [ sh:description "Stable, globally unique ORD identifier for resources, taxonomy entities, and system-context entities." ;
            sh:name "ORD ID" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:ordId ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier used to correlate the ORD entity with related data in another repository or system of record." ;
            sh:name "Correlation ID" ;
            sh:path ord:correlationId ],
        [ sh:datatype xsd:string ;
            sh:description "Complete Semantic Versioning version string." ;
            sh:name "Version" ;
            sh:path ord:version ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text tag. Character constraints are defined in SHACL." ;
            sh:name "Tag" ;
            sh:path ord:tag ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text custom description of an ORD entity." ;
            sh:name "Custom Description" ;
            sh:path ord:customDescription ],
        [ sh:class ord:ORDResourceDefinition ;
            sh:name "resource_definitions" ;
            sh:path ord:resourceDefinition ],
        [ sh:description "Typed ORD ID references to related API resources." ;
            sh:name "Related API Resources" ;
            sh:path ord:relatedApiResources ],
        [ sh:description "Product this ORD entity is part of." ;
            sh:name "Part of Product" ;
            sh:path ord:partOfProduct ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "part_of_package" ;
            sh:nodeKind sh:IRI ;
            sh:path ord:partOfPackage ],
        [ sh:description "A single entity type exposed by an API or event resource." ;
            sh:name "Exposed Entity Type" ;
            sh:path ord:exposedEntityType ],
        [ sh:description "Generic link attached to an ORD entity." ;
            sh:name "Link" ;
            sh:path ord:link ],
        [ sh:datatype xsd:string ;
            sh:name "integration_dependencies" ;
            sh:path ord:integrationDependency ],
        [ sh:name "industry" ;
            sh:nodeKind sh:IRI ;
            sh:path ord:industry ],
        [ sh:class ord:ApiEventResourceLink ;
            sh:name "api_event_resource_links" ;
            sh:path ord:url ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "ord_id" ;
            sh:path ord:ordId ],
        [ sh:description "Typed ORD ID references to related event resources." ;
            sh:name "Related Event Resources" ;
            sh:path ord:relatedEventResources ],
        [ sh:class ord:ChangelogEntry ;
            sh:name "changelog_entries" ;
            sh:path ord:changelogEntry ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:name "last_update" ;
            sh:path ord:lastUpdate ],
        [ sh:description "ORD ID of the default consumption bundle for this resource." ;
            sh:name "Default Consumption Bundle" ;
            sh:path ord:defaultConsumptionBundle ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <https://open-resource-discovery.org/vocab#Agent> . FILTER NOT EXISTS { ?this a <https://open-resource-discovery.org/vocab#ExternalReference> } }" ] .

ord:ApiCompatibilityShape a sh:NodeShape ;
    sh:description "Declares that an API resource is compatible with an abstract API interface contract." ;
    sh:name "API Compatibility" ;
    sh:property [ sh:description "Label used to classify or identify documentation." ;
            sh:name "Documentation Label" ;
            sh:path ord:documentationLabel ],
        [ sh:description "Declares compatibility with another resource, interface, or abstract contract." ;
            sh:name "Compatible With" ;
            sh:path ord:compatibleWith ],
        [ sh:datatype xsd:string ;
            sh:description "Custom type identifier used when the link or credential-exchange type is 'custom'." ;
            sh:name "Custom Type" ;
            sh:path ord:customType ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <https://open-resource-discovery.org/vocab#ApiCompatibility> . FILTER NOT EXISTS { ?this a <https://open-resource-discovery.org/vocab#ExternalReference> } }" ] .

ord:ApiDocumentationLinkShape a sh:NodeShape ;
    sh:description "Link to API documentation." ;
    sh:name "API Documentation Link" ;
    sh:property [ sh:description "Declares compatibility with another resource, interface, or abstract contract." ;
            sh:name "Compatible With" ;
            sh:path ord:compatibleWith ],
        [ sh:description "Label used to classify or identify documentation." ;
            sh:name "Documentation Label" ;
            sh:path ord:documentationLabel ],
        [ sh:description "Semantic type of a typed link. Values depend on the link class." ;
            sh:name "Link Type" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:linkType ],
        [ sh:datatype xsd:string ;
            sh:description "Custom type identifier used when the link or credential-exchange type is 'custom'." ;
            sh:name "Custom Type" ;
            sh:path ord:customType ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <https://open-resource-discovery.org/vocab#ApiDocumentationLink> . FILTER NOT EXISTS { ?this a <https://open-resource-discovery.org/vocab#ExternalReference> } }" ] .

ord:ApiEventResourceLinkShape a sh:NodeShape ;
    sh:description "A semantically typed link specific to API or event resources." ;
    sh:name "API/Event Resource Link" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Custom type identifier used when the link or credential-exchange type is 'custom'." ;
            sh:name "Custom Type" ;
            sh:path ord:customType ],
        [ sh:description "Semantic type of a typed link. Values depend on the link class." ;
            sh:name "Link Type" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:linkType ],
        [ sh:description "Declares compatibility with another resource, interface, or abstract contract." ;
            sh:name "Compatible With" ;
            sh:path ord:compatibleWith ],
        [ sh:description "Label used to classify or identify documentation." ;
            sh:name "Documentation Label" ;
            sh:path ord:documentationLabel ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <https://open-resource-discovery.org/vocab#ApiEventResourceLink> . FILTER NOT EXISTS { ?this a <https://open-resource-discovery.org/vocab#ExternalReference> } }" ] .

ord:ApiModelSelectorShape a sh:NodeShape ;
    sh:description "Selector used to select a model within an API resource." ;
    sh:name "API Model Selector" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Custom type identifier used when the link or credential-exchange type is 'custom'." ;
            sh:name "Custom Type" ;
            sh:path ord:customType ],
        [ sh:description "Declares compatibility with another resource, interface, or abstract contract." ;
            sh:name "Compatible With" ;
            sh:path ord:compatibleWith ],
        [ sh:description "Label used to classify or identify documentation." ;
            sh:name "Documentation Label" ;
            sh:path ord:documentationLabel ] ;
    sh:target [ a sh:SPARQLTarget ;
            sh:select "SELECT ?this WHERE { ?this a <https://open-resource-discovery.org/vocab#ApiModelSelector> . FILTER NOT EXISTS { ?this a <https://open-resource-discovery.org/vocab#ExternalReference> } }" ] .

ord:ApiResourceDefinitionShape a sh:NodeShape ;
    sh:description "Machine-readable API resource definition." ;
    sh:name "API Resource Definition" ;
    sh:property [ sh:description "Line-of-business classification associated with an ORD entity. In normalized RDF, values should be SKOS concepts from ord:LineOfBusinessConceptScheme or a compatible extension scheme." ;
            sh:name "Line of Business" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:lineOfBusiness ],
        [ sh:description "Label used to classify or identify documentation." ;
            sh:name "Documentation Label" ;
            sh:path ord:documentationLabel ],
        [ sh:description "Visibility or exposure level of an ORD entity." ;
            sh:name "Visibility" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:visibility ],
        [ sh:description "Stable, globally unique ORD identifier for resources, taxonomy entities, and system-context entities." ;
            sh:name "ORD ID" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:ordId ],
        [ sh:datatype xsd:string ;
            sh:description "Complete Semantic Versioning version string." ;
            sh:name "Version" ;
            sh:path ord:version ],
        [ sh:description "Vendor responsible for or associated with the described ORD entity." ;
            sh:name "Vendor" ;
            sh:path ord:vendor ],
        [ sh:datatype xsd:string ;
            sh:description "Deprecated since ORD spec v1.9.9. Custom policy level specification identifier. Use ord:policyLevel with a SKOS concept instead." ;
            sh:name "Custom Policy Level" ;
            sh:path ord:customPolicyLevel ],
        [ sh:datatype xsd:dateTime ;
            sh:description "RFC 3339 date-time indicating when an ORD resource or entity is planned to be sunset." ;
            sh:name "Sunset Date" ;
            sh:path ord:sunsetDate ],
        [ sh:datatype xsd:string ;
            sh:description "ORD ID of a referenced related resource." ;
            sh:name "Related ORD ID" ;
            sh:path ord:relatedOrdId ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text tag. Character constraints are defined in SHACL." ;
            sh:name "Tag" ;
            sh:path ord:tag ],
        [ sh:description "Product this ORD entity is part of." ;
            sh:name "Part of Product" ;
            sh:path ord:partOfProduct ],
        [ sh:description "Generic link attached to an ORD entity." ;
            sh:name "Link" ;
            sh:path ord:link ],
        [ sh:description "Typed ORD ID references to related capabilities." ;
            sh:name "Related Capabilities" ;
            sh:path ord:relatedCapabilities ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable title." ;
            sh:name "Title" ;
            sh:path ord:title ],
        [ sh:description "Intended purpose or role of a resource definition." ;
            sh:name "Purpose" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:purpose ],
        [ sh:datatype xsd:string ;
            sh:description "Country code according to ISO 3166-1 alpha-2. Countries assigned to a package are inherited by contained resources." ;
            sh:name "Country" ;
            sh:path ord:country ],
        [ sh:description "Supported access strategy for retrieving metadata from an ORD provider." ;
            sh:name "Access Strategy" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:accessStrategy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "RFC 3339 date-time on which the ORD resource or taxonomy entity was tombstoned or removed." ;
            sh:name "Removed Date" ;
            sh:path ord:removedDate ],
        [ sh:description "Industry classification associated with an ORD entity. In normalized RDF, values should be SKOS concepts from ord:IndustryConceptScheme or a compatible extension scheme." ;
            sh:name "Industry" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:industry ],
        [ sh:description "Declares compatibility with another resource, interface, or abstract contract." ;
            sh:name "Compatible With" ;
            sh:path ord:compatibleWith ],
        [ sh:datatype xsd:string ;
            sh:description "Custom type identifier used when the link or credential-exchange type is 'custom'." ;
            sh:name "Custom Type" ;
            sh:path ord:customType ],
        [ sh:description "Relates an ORD entity to another concept or resource." ;
            sh:name "Related" ;
            sh:path ord:related ],
        [ sh:datatype xsd:string ;
            sh:description "Detailed human-readable description." ;
            sh:name "Description" ;
            sh:path ord:description ],
        [ sh:datatype xsd:string ;
            sh:description "Additional hint intended to support AI-assisted interpretation or discovery." ;
            sh:name "AI Hint" ;
            sh:path ord:aiHint ],
        [ sh:description "Entity type related to another entity type or resource." ;
            sh:name "Related Entity Type" ;
            sh:path ord:relatedEntityType ],
        [ sh:description "Successor resource or entity." ;
            sh:name "Successor" ;
            sh:path ord:successor ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates whether the entity is disabled." ;
            sh:name "Disabled" ;
            sh:path ord:disabled ],
        [ sh:description "Contains changelog entries that summarize changes, especially with regard to version and release status." ;
            sh:name "Changelog Entry" ;
            sh:path ord:changelogEntry ],
        [ sh:datatype xsd:string ;
            sh:description "Plain-text short description." ;
            sh:name "Short Description" ;
            sh:path ord:shortDescription ],
        [ sh:description "Optional semantic type of a relationship." ;
            sh:name "Relation Type" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:relationType ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text custom description of an ORD entity." ;
            sh:name "Custom Description" ;
            sh:path ord:customDescription ],
        [ sh:description "Typed ORD ID references to related event resources." ;
            sh:name "Related Event Resources" ;
            sh:path ord:relatedEventResources ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicates that the described resource is abstract or interface-only." ;
            sh:name "Abstract" ;
            sh:path ord:abstract ],
        [ sh:description "Policy or compliance level that the described ORD document, package, or resource needs to comply with." ;
            sh:name "Policy Level" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:policyLevel ],
        [ sh:description "Key-value metadata label attached to ORD resources." ;
            sh:name "Label" ;
            sh:path ord:label ],
        [ sh:datatype xsd:boolean ;
            sh:description "Defines whether the resource's extension information is extensible." ;
            sh:name "Extensible" ;
            sh:path ord:extensible ],
        [ sh:datatype xsd:string ;
            sh:description "Person, team, or organizational unit responsible for this resource." ;
            sh:name "Responsible" ;
            sh:path ord:responsible ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier used to correlate the ORD entity with related data in another repository or system of record." ;
            sh:name "Correlation ID" ;
            sh:path ord:correlationId ],
        [ sh:description "Release lifecycle status of an ORD entity." ;
            sh:name "Release Status" ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
            sh:path ord:releaseStatus ],
        [ sh:description "Entity type that the concept or resource is related to." ;
            sh:name "Entity Type" ;
            sh:path ord:entityType ],
        [ sh:description "Group this ORD entity is part of." ;
            sh:name "Part of Group" ;
            sh:path ord:partOfGroup ],
        [ sh:datatype xsd:string ;
            sh:description "Media type of a resource definition." ;
            sh:name "Media Type" ;
            sh:path ord:mediaType ],
        [ sh:datatype xsd:string ;
            sh:description "Local identifier as known by the described system." ;
            sh:name "Local ID" ;
