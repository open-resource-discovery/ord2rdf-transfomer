    skos:topConceptOf ord:VisibilityScheme .

ord:Visibility-internal a skos:Concept ;
    skos:prefLabel "internal"@en ;
    skos:notation "internal" ;
    skos:definition "Visible within an organization or restricted internal context."@en ;
