ord:successor
    a rdf:Property ;
    rdfs:label "Successor"@en ;
    rdfs:comment "Successor resource or entity."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:ORDEntity ;
    rdfs:isDefinedBy ord: .

ord:partOfProduct
    a rdf:Property ;
    rdfs:label "Part of Product"@en ;
    rdfs:comment "Product this ORD entity is part of."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:Product ;
    rdfs:isDefinedBy ord: .

ord:partOfPackage
    a rdf:Property ;
    rdfs:label "Part of Package"@en ;
    rdfs:comment "Package this ORD resource is part of."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range ord:Package ;
    rdfs:isDefinedBy ord: .

ord:partOfGroup
    a rdf:Property ;
    rdfs:label "Part of Group"@en ;
    rdfs:comment "Group this ORD entity is part of."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:Group ;
    rdfs:isDefinedBy ord: .

ord:vendor
    a rdf:Property ;
    rdfs:label "Vendor"@en ;
    rdfs:comment "Vendor responsible for or associated with the described ORD entity."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:Vendor ;
    rdfs:isDefinedBy ord: .

ord:partner
    a rdf:Property ;
    rdfs:label "Partner"@en ;
    rdfs:comment "Partner vendor relationship."@en ;
    rdfs:domain ord:Vendor ;
    rdfs:range ord:Vendor ;
    rdfs:isDefinedBy ord: .

ord:correlationId
    a rdf:Property ;
    rdfs:label "Correlation ID"@en ;
    rdfs:comment "Identifier used to correlate the ORD entity with related data in another repository or system of record."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:compatibleWith
    a rdf:Property ;
    rdfs:label "Compatible With"@en ;
    rdfs:comment "Declares compatibility with another resource, interface, or abstract contract."@en ;
    rdfs:domain ord:Concept ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

ord:removedResource
    a rdf:Property ;
    rdfs:label "Removed Resource"@en ;
    rdfs:comment "Resource or taxonomy entity removed by a tombstone."@en ;
    rdfs:domain ord:Tombstone ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Link, File, and Resource Definition Properties
# =============================================================================

ord:link
    a rdf:Property ;
    rdfs:label "Link"@en ;
    rdfs:comment "Generic link attached to an ORD entity."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:Link ;
    rdfs:isDefinedBy ord: .

ord:resourceLink
    a rdf:Property ;
    rdfs:label "Resource Link"@en ;
    rdfs:comment "Semantically typed link specific to ORD resources."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range ord:ORDTypedLink ;
    rdfs:isDefinedBy ord: .

ord:linkType
    a rdf:Property ;
    rdfs:label "Link Type"@en ;
    rdfs:comment "Semantic type of a typed link. Values depend on the link class."@en ;
    rdfs:domain ord:ORDTypedLink ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:url
    a rdf:Property ;
    rdfs:label "URL"@en ;
    rdfs:comment "Absolute URL target."@en ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy ord: .

ord:baseUrl
    a rdf:Property ;
    rdfs:label "Base URL"@en ;
    rdfs:comment "Base URL of a system instance or resource."@en ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy ord: .

ord:mediaType
    a rdf:Property ;
    rdfs:label "Media Type"@en ;
    rdfs:comment "Media type of a resource definition."@en ;
    rdfs:domain ord:ORDResourceDefinition ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:type
    a rdf:Property ;
    rdfs:label "Type"@en ;
    rdfs:comment "Type of a resource definition, link, or supporting entity."@en ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:purpose
    a rdf:Property ;
    rdfs:label "Purpose"@en ;
    rdfs:comment "Intended purpose or role of a resource definition."@en ;
    rdfs:domain ord:ORDResourceDefinition ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:accessStrategy
    a rdf:Property ;
    rdfs:label "Access Strategy"@en ;
    rdfs:comment "Supported access strategy for retrieving metadata from an ORD provider."@en ;
    rdfs:domain ord:ORDResourceDefinition ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:resourceDefinition
    a rdf:Property ;
    rdfs:label "Resource Definition"@en ;
    rdfs:comment "Machine-readable resource definition associated with an ORD resource."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range ord:ORDResourceDefinition ;
    rdfs:isDefinedBy ord: .

ord:file
    a rdf:Property ;
    rdfs:label "File"@en ;
    rdfs:comment "File attached to an ORD package."@en ;
    rdfs:domain ord:Package ;
    rdfs:range ord:File ;
    rdfs:isDefinedBy ord: .

ord:license
    a rdf:Property ;
    rdfs:label "License"@en ;
    rdfs:comment "License identifier or reference. SPDX identifiers are recommended where applicable."@en ;
    rdfs:domain ord:Package ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:license ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Entity Type and Model Selector Properties
# =============================================================================

ord:entityType
    a rdf:Property ;
    rdfs:label "Entity Type"@en ;
    rdfs:comment "Entity type that the concept or resource is related to."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:EntityType ;
    rdfs:isDefinedBy ord: .

ord:exposedEntityType
    a rdf:Property ;
    rdfs:label "Exposed Entity Type"@en ;
    rdfs:comment "A single entity type exposed by an API or event resource."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range ord:ExposedEntityType ;
    rdfs:isDefinedBy ord: .

ord:relatedEntityType
    a rdf:Property ;
    rdfs:label "Related Entity Type"@en ;
    rdfs:comment "Entity type related to another entity type or resource."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:RelatedEntityType ;
    rdfs:isDefinedBy ord: .

ord:entityTypeMapping
    a rdf:Property ;
    rdfs:label "Entity Type Mapping"@en ;
    rdfs:comment "Mapping between API models and conceptual entity types."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range ord:EntityTypeMapping ;
    rdfs:isDefinedBy ord: .

ord:apiModelSelector
    a rdf:Property ;
    rdfs:label "API Model Selector"@en ;
    rdfs:comment "Selector that identifies a model element inside an API definition."@en ;
    rdfs:domain ord:EntityTypeMapping ;
    rdfs:range ord:ApiModelSelector ;
    rdfs:isDefinedBy ord: .

ord:entitySetName
    a rdf:Property ;
    rdfs:label "Entity Set Name"@en ;
    rdfs:comment "OData entity set name used by an OData API model selector."@en ;
    rdfs:domain ord:OdataApiModelSelector ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:jsonPointer
    a rdf:Property ;
    rdfs:label "JSON Pointer"@en ;
    rdfs:comment "JSON Pointer used by a JSON Pointer API model selector."@en ;
    rdfs:domain ord:JsonPointerApiModelSelector ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Label, Documentation, and Changelog Properties
# =============================================================================

ord:label
    a rdf:Property ;
    rdfs:label "Label"@en ;
    rdfs:comment "Key-value metadata label attached to ORD resources."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:Label ;
    rdfs:isDefinedBy ord: .

ord:key
    a rdf:Property ;
    rdfs:label "Key"@en ;
    rdfs:comment "Key of a key-value label."@en ;
    rdfs:domain ord:Label ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:value
    a rdf:Property ;
    rdfs:label "Value"@en ;
    rdfs:comment "Value of a key-value label."@en ;
    rdfs:domain ord:Label ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:documentationLabel
    a rdf:Property ;
    rdfs:label "Documentation Label"@en ;
    rdfs:comment "Label used to classify or identify documentation."@en ;
    rdfs:domain ord:Concept ;
    rdfs:range ord:DocumentationLabel ;
    rdfs:isDefinedBy ord: .

ord:changelogEntry
    a rdf:Property ;
    rdfs:label "Changelog Entry"@en ;
    rdfs:comment "Contains changelog entries that summarize changes, especially with regard to version and release status."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range ord:ChangelogEntry ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# System Context Properties
# =============================================================================

ord:describedSystemInstance
    a rdf:Property ;
    rdfs:label "Described System Instance"@en ;
    rdfs:comment "System instance described by an ORD document."@en ;
    rdfs:domain ord:Document ;
    rdfs:range ord:SystemInstance ;
    rdfs:isDefinedBy ord: .

ord:systemType
    a rdf:Property ;
    rdfs:label "System Type"@en ;
    rdfs:comment "System type associated with a system version or system instance."@en ;
    rdfs:range ord:SystemType ;
    rdfs:isDefinedBy ord: .

ord:systemVersion
    a rdf:Property ;
    rdfs:label "System Version"@en ;
    rdfs:comment "System version associated with a system instance."@en ;
    rdfs:range ord:SystemVersion ;
    rdfs:isDefinedBy ord: .

ord:minSystemVersion
    a rdf:Property ;
    rdfs:label "Minimum System Version"@en ;
    rdfs:comment "Minimum system version from which a resource is available."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Group, Bundle, Integration, and Data Product Properties
# =============================================================================

ord:groupType
    a rdf:Property ;
    rdfs:label "Group Type"@en ;
    rdfs:comment "Group type assigned to a group."@en ;
    rdfs:domain ord:Group ;
    rdfs:range ord:GroupType ;
    rdfs:isDefinedBy ord: .

ord:inputPort
    a rdf:Property ;
    rdfs:label "Input Port"@en ;
    rdfs:comment "Input port of a data product."@en ;
    rdfs:domain ord:DataProduct ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

ord:outputPort
    a rdf:Property ;
    rdfs:label "Output Port"@en ;
    rdfs:comment "Output port of a data product."@en ;
    rdfs:domain ord:DataProduct ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

ord:integrationAspect
    a rdf:Property ;
    rdfs:label "Integration Aspect"@en ;
    rdfs:comment "Integration aspect associated with an integration dependency."@en ;
    rdfs:domain ord:IntegrationDependency ;
    rdfs:range ord:IntegrationAspect ;
    rdfs:isDefinedBy ord: .

ord:consumptionBundle
    a rdf:Property ;
    rdfs:label "Consumption Bundle"@en ;
    rdfs:comment "Consumption bundle referenced by a consumption bundle reference."@en ;
    rdfs:domain ord:ConsumptionBundleReference ;
    rdfs:range ord:ConsumptionBundle ;
    rdfs:isDefinedBy ord: .

ord:defaultEntryPoint
    a rdf:Property ;
    rdfs:label "Default Entry Point"@en ;
    rdfs:comment "Default entry point URL for a consumption bundle reference."@en ;
    rdfs:domain ord:ConsumptionBundleReference ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy ord: .

ord:credentialExchangeStrategy
    a rdf:Property ;
    rdfs:label "Credential Exchange Strategy"@en ;
    rdfs:comment "Credential exchange strategy associated with a consumption bundle."@en ;
    rdfs:domain ord:ConsumptionBundle ;
    rdfs:range ord:CredentialExchangeStrategy ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# API / Resource Implementation Properties
# =============================================================================

ord:apiProtocol
    a rdf:Property ;
    rdfs:label "API Protocol"@en ;
    rdfs:comment "Protocol used by an API resource. Values should be SKOS concepts from ord:ApiProtocolScheme or a compatible extension scheme."@en ;
    rdfs:domain ord:APIResource ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:implementationStandard
    a rdf:Property ;
    rdfs:label "Implementation Standard"@en ;
    rdfs:comment "Externally standardized API contract, sub-protocol, or protocol variant implemented by a resource."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:standardDescription
    a rdf:Property ;
    rdfs:label "Implementation Standard Description"@en ;
    rdfs:comment "Full description of a custom implementation standard."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description ;
    rdfs:isDefinedBy ord: .

ord:usage
    a rdf:Property ;
    rdfs:label "Usage"@en ;
    rdfs:comment "Usage classification of a resource."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Vendor Extension / Profile Support
# =============================================================================

ord:Profile
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "ORD Profile"@en ;
    rdfs:comment "A profile defines additional constraints, controlled values, or extensions for a particular implementation context."@en ;
    rdfs:isDefinedBy ord: .

ord:extendsVocabulary
    a rdf:Property ;
    rdfs:label "Extends Vocabulary"@en ;
    rdfs:comment "Indicates that a profile or extension vocabulary extends another vocabulary."@en ;
    rdfs:domain ord:Profile ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# SKOS Concept Schemes
# =============================================================================

ord:IndustryConceptScheme
    a skos:ConceptScheme ;
    rdfs:label "Industry Concept Scheme"@en ;
    skos:prefLabel "Industry Concept Scheme"@en ;
    skos:definition "Controlled vocabulary of industries applicable to ORD resources and packages."@en ;
    skos:hasTopConcept
        ord:AerospaceAndDefense,
        ord:Agribusiness,
        ord:Automotive,
        ord:Banking,
        ord:Chemicals,
        ord:ConsumerProducts,
        ord:DefenseAndSecurity,
        ord:EngineeringConstructionAndOperations,
        ord:Healthcare,
        ord:HighTech,
        ord:HigherEducationAndResearch,
        ord:IndustrialMachineryAndComponents,
        ord:Insurance,
        ord:LifeSciences,
        ord:Media,
        ord:MillProducts,
        ord:Mining,
        ord:OilAndGas,
        ord:ProfessionalServices,
        ord:PublicSector,
        ord:PublicServices,
        ord:Retail,
        ord:ServiceIndustries,
        ord:SportsAndEntertainment,
        ord:Telecommunications,
        ord:TravelAndTransportation,
        ord:Utilities,
        ord:WholesaleDistribution ;
    rdfs:isDefinedBy ord: .

ord:LineOfBusinessConceptScheme
    a skos:ConceptScheme ;
    rdfs:label "Line of Business Concept Scheme"@en ;
    skos:prefLabel "Line of Business Concept Scheme"@en ;
    skos:definition "Controlled vocabulary of lines of business applicable to ORD resources and packages."@en ;
    skos:hasTopConcept
        ord:AssetManagement,
        ord:Commerce,
        ord:Finance,
        ord:GridOperationsAndMaintenance,
        ord:HumanResources,
        ord:MaintenanceAndEngineering,
        ord:Manufacturing,
        ord:Marketing,
        ord:Metering,
        ord:PlantOperationsAndMaintenance,
        ord:ResearchAndDevelopmentEngineering,
        ord:Sales,
        ord:Service,
        ord:SourcingAndProcurement,
        ord:StrategyComplianceAndGovernance,
        ord:SupplyChain,
        ord:Sustainability ;
    rdfs:isDefinedBy ord: .

ord:VisibilityScheme
    a skos:ConceptScheme ;
    rdfs:label "Visibility Scheme"@en ;
    skos:prefLabel "Visibility Scheme"@en ;
    skos:definition "Controlled vocabulary for visibility values."@en ;
    skos:hasTopConcept
        ord:Visibility-public,
        ord:Visibility-internal,
        ord:Visibility-private ;
    rdfs:isDefinedBy ord: .

ord:ReleaseStatusScheme
    a skos:ConceptScheme ;
    rdfs:label "Release Status Scheme"@en ;
    skos:prefLabel "Release Status Scheme"@en ;
    skos:definition "Controlled vocabulary for release lifecycle status."@en ;
    skos:hasTopConcept
        ord:ReleaseStatus-development,
        ord:ReleaseStatus-beta,
        ord:ReleaseStatus-active,
        ord:ReleaseStatus-deprecated,
        ord:ReleaseStatus-sunset ;
    rdfs:isDefinedBy ord: .

ord:PolicyLevelScheme
    a skos:ConceptScheme ;
    rdfs:label "Policy Level Scheme"@en ;
    skos:prefLabel "Policy Level Scheme"@en ;
    skos:definition "Controlled vocabulary for policy or compliance levels applicable to ORD documents, packages, and resources."@en ;
    skos:hasTopConcept
        ord:PolicyLevel-none,
        ord:PolicyLevel-custom ;
    rdfs:isDefinedBy ord: .

ord:UsageScheme
    a skos:ConceptScheme ;
    rdfs:label "Usage Scheme"@en ;
    skos:prefLabel "Usage Scheme"@en ;
    skos:definition "Controlled vocabulary for resource usage patterns."@en ;
    skos:hasTopConcept
        ord:Usage-local,
        ord:Usage-external,
        ord:Usage-dataFederation,
        ord:Usage-snapshot,
        ord:Usage-incremental,
        ord:Usage-streaming ;
    rdfs:isDefinedBy ord: .

ord:ApiProtocolScheme
    a skos:ConceptScheme ;
    rdfs:label "API Protocol Scheme"@en ;
    skos:prefLabel "API Protocol Scheme"@en ;
    skos:definition "Controlled vocabulary for open or vendor-neutral API protocols."@en ;
    skos:hasTopConcept
        ord:ApiProtocol-rest,
