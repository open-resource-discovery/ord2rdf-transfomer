    skos:topConceptOf ord:VisibilityScheme .

ord:Visibility-private a skos:Concept ;
    skos:prefLabel "private"@en ;
    skos:notation "private" ;
    skos:definition "Private or restricted visibility."@en ;
    skos:inScheme ord:VisibilityScheme ;
    skos:topConceptOf ord:VisibilityScheme .

ord:ReleaseStatus-development a skos:Concept ;
    skos:prefLabel "development"@en ;
    skos:notation "development" ;
    skos:definition "Unreleased and under active development. The contract is unstable and may change."@en ;
    skos:inScheme ord:ReleaseStatusScheme ;
    skos:topConceptOf ord:ReleaseStatusScheme .

ord:ReleaseStatus-beta a skos:Concept ;
    skos:prefLabel "beta"@en ;
    skos:notation "beta" ;
    skos:definition "Released but without final stability guarantees. Breaking changes may occur."@en ;
    skos:inScheme ord:ReleaseStatusScheme ;
    skos:topConceptOf ord:ReleaseStatusScheme .

ord:ReleaseStatus-active a skos:Concept ;
    skos:prefLabel "active"@en ;
    skos:notation "active" ;
    skos:definition "Stable and recommended for production use."@en ;
    skos:inScheme ord:ReleaseStatusScheme ;
    skos:topConceptOf ord:ReleaseStatusScheme .

ord:ReleaseStatus-deprecated a skos:Concept ;
    skos:prefLabel "deprecated"@en ;
    skos:notation "deprecated" ;
    skos:definition "Functional but scheduled for removal. New development should not depend on it."@en ;
    skos:inScheme ord:ReleaseStatusScheme ;
    skos:topConceptOf ord:ReleaseStatusScheme .

ord:ReleaseStatus-sunset a skos:Concept ;
    skos:prefLabel "sunset"@en ;
    skos:notation "sunset" ;
    skos:definition "No longer recommended or scheduled for shutdown or removal."@en ;
    skos:inScheme ord:ReleaseStatusScheme ;
    skos:topConceptOf ord:ReleaseStatusScheme .

