# =============================================================================
# ORD Vocabulary — Open Resource Discovery
#
# Namespace: https://open-resource-discovery.org/vocab/v1#
# Prefix: ord
#
# Standards used:
#   RDF, RDFS, SKOS, XSD, DCAT, FOAF, DCTERMS
# =============================================================================

@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat:     <http://www.w3.org/ns/dcat#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix ord:      <https://open-resource-discovery.org/vocab/v1#> .
@prefix ordspec:  <https://open-resource-discovery.org/spec-v1/> .

# =============================================================================
# Vocabulary Metadata
# =============================================================================

ord:
    a rdfs:Resource ;
    rdfs:label "ORD Vocabulary v1"@en ;
    rdfs:comment """RDF/RDFS/SKOS vocabulary derived from the Open Resource Discovery JSON Schema.
It describes the conceptual model of an ORD document, including resources, taxonomy entities,
system context, resource definitions, links, controlled vocabularies, and lifecycle metadata.

This vocabulary is intended as an open, vendor-neutral semantic model that vendors can extend
in their own namespaces for internal ERP metadata and knowledge graph generation."""@en ;
    dcterms:title "Open Resource Discovery Vocabulary v1"@en ;
    dcterms:description "Open, vendor-neutral RDF/RDFS/SKOS vocabulary for ORD metadata and ERP knowledge graph generation."@en ;
    dcterms:source ordspec: ;
    dcterms:hasVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:v1
    a rdfs:Resource ;
    rdfs:label "ORD Vocabulary v1"@en ;
    rdfs:comment "Version resource for version 1.0 of the ORD open vocabulary."@en ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Governance / Lifecycle Annotation Properties
# =============================================================================

ord:vocabularyVersion
    a rdf:Property ;
    rdfs:label "Vocabulary Version"@en ;
    rdfs:comment "Version resource of the vocabulary in which a term is defined."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

ord:introducedInVersion
    a rdf:Property ;
    rdfs:label "Introduced in Version"@en ;
    rdfs:comment "ORD specification or document interface version in which a term was introduced."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:featureStatus
    a rdf:Property ;
    rdfs:label "Feature Status"@en ;
    rdfs:comment "Feature maturity status of a term, for example alpha, beta, or stable."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:deprecated
    a rdf:Property ;
    rdfs:label "Deprecated"@en ;
    rdfs:comment "Boolean flag indicating that a vocabulary term is deprecated and should no longer be used for new metadata."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy ord: .

ord:deprecatedSinceVersion
    a rdf:Property ;
    rdfs:label "Deprecated Since Version"@en ;
    rdfs:comment "ORD specification or document interface version since which the term has been deprecated."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:supersededBy
    a rdf:Property ;
    rdfs:label "Superseded By"@en ;
    rdfs:comment "Points from a deprecated vocabulary term to the replacement term."@en ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Abstract / Superclasses
# =============================================================================

ord:Concept
    a rdfs:Class ;
    rdfs:label "ORD Concept"@en ;
    rdfs:comment "Generic superclass for concepts represented in ORD."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:TopConcept
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "ORD Top Concept"@en ;
    rdfs:comment "Top-level ORD concept."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:ORDEntity
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "ORD Entity"@en ;
    rdfs:comment "Superclass for identifiable ORD entities, including resources, taxonomy entities, and system-context entities."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:ORDResource
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDEntity ;
    rdfs:label "ORD Resource"@en ;
    rdfs:comment "Superclass for discoverable ORD resources such as APIs, events, data products, capabilities, overlays, agents, and integration dependencies."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:ORDTaxonomy
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDEntity ;
    rdfs:label "ORD Taxonomy"@en ;
    rdfs:comment "Superclass for taxonomy entities that organize ORD resources, including vendors, products, packages, groups, and group types."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:ORDSystemContext
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDEntity ;
    rdfs:label "ORD System Context"@en ;
    rdfs:comment "Superclass for system context entities such as system type, system version, and system instance."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:ORDResourceDefinition
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDEntity ;
    rdfs:label "ORD Resource Definition"@en ;
    rdfs:comment "Superclass for machine-readable resource definitions such as API definitions, event definitions, data product definitions, capability definitions, entity type definitions, and overlay definitions."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Root-Level Entity Classes
# =============================================================================

ord:Document
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDEntity ;
    rdfs:label "ORD Document"@en ;
    rdfs:comment "An ORD document describes ORD resources, taxonomy entities, system context, and their relationships."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Vendor
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTaxonomy ;
    rdfs:label "Vendor"@en ;
    rdfs:comment "A vendor is a company or organization that sells or provides products, services, or resources."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Organization
    a rdfs:Class ;
    rdfs:subClassOf foaf:Organization ;
    rdfs:label "Organization"@en ;
    rdfs:comment "An organization is a group of people or legal entity working toward a common goal."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Product
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTaxonomy ;
    rdfs:label "Product"@en ;
    rdfs:comment "A product is a commercial or organizational product or service grouping ORD resources."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Package
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTaxonomy ;
    rdfs:label "Package"@en ;
    rdfs:comment "A package is a collection of ORD resources grouped together for distribution."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Group
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTaxonomy ;
    rdfs:label "Group"@en ;
    rdfs:comment "A group is a lightweight taxonomy concept used to organize ORD resources."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:GroupType
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTaxonomy ;
    rdfs:label "Group Type"@en ;
    rdfs:comment "A group type classifies groups."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:SystemType
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDSystemContext ;
    rdfs:label "System Type"@en ;
    rdfs:comment "A system type describes an abstract type of system."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:SystemVersion
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDSystemContext ;
    rdfs:label "System Version"@en ;
    rdfs:comment "A system version describes a design-time version or release of a system type."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:SystemInstance
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDSystemContext ;
    rdfs:label "System Instance"@en ;
    rdfs:comment "A system instance describes a concrete deployed or running instance of a system."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:APIResource
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "API Resource"@en ;
    rdfs:comment "An API resource is an ORD resource describing an API."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:EventResource
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "Event Resource"@en ;
    rdfs:comment "An event resource is an ORD resource describing events or event-based interfaces."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:DataProduct
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "Data Product"@en ;
    rdfs:comment "A data product is a collection of data made available for use."@en ;
    ord:introducedInVersion "1.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:DataService
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "Data Service"@en ;
    rdfs:comment "A data service is an ORD resource that exposes or provides access to data."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Capability
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "Capability"@en ;
    rdfs:comment "A capability describes a functional or business capability represented in ORD."@en ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:IntegrationDependency
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "Integration Dependency"@en ;
    rdfs:comment "An integration dependency describes a dependency required for integration."@en ;
    ord:introducedInVersion "1.7.0" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Agent
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "Agent"@en ;
    rdfs:comment "An AI-powered autonomous system that can perform tasks, make decisions, and interact with users or other systems to achieve business goals."@en ;
    ord:introducedInVersion "1.14.0" ;
    ord:featureStatus "beta" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

ord:Overlay
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResource ;
    rdfs:label "Overlay"@en ;
    rdfs:comment "A standalone, versioned resource referencing a metadata patch or overlay document that enriches resource definitions without modifying the originals."@en ;
    ord:introducedInVersion "1.15.0" ;
    ord:featureStatus "alpha" ;
    ord:vocabularyVersion ord:v1 ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Embedded / Supporting Classes
# =============================================================================

ord:Link
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Link"@en ;
    rdfs:comment "Link that can be attached to packages or ORD resources."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:ORDTypedLink
    a rdfs:Class ;
    rdfs:subClassOf ord:Link ;
    rdfs:label "ORD Typed Link"@en ;
    rdfs:comment "A link with semantic type information."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:PackageLink
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTypedLink ;
    rdfs:label "Package Link"@en ;
    rdfs:comment "A semantically typed link specific to packages."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:ApiEventResourceLink
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTypedLink ;
    rdfs:label "API/Event Resource Link"@en ;
    rdfs:comment "A semantically typed link specific to API or event resources."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:DataProductLink
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTypedLink ;
    rdfs:label "Data Product Link"@en ;
    rdfs:comment "A semantically typed link specific to data products."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:File
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "ORD File"@en ;
    rdfs:comment "File that can be attached on ORD package level."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:ChangelogEntry
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Changelog Entry"@en ;
    rdfs:comment "A changelog entry summarizes changes, usually with regard to version or release status."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:Label
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Label"@en ;
    rdfs:comment "Key-value metadata label attached to ORD resources."@en ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:EntityType
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDEntity ;
    rdfs:label "Entity Type"@en ;
    rdfs:comment "A conceptual entity type described or referenced in ORD."@en ;
    rdfs:isDefinedBy ord: .

ord:OrdEntityType
    a rdfs:Class ;
    rdfs:subClassOf ord:EntityType ;
    rdfs:label "ORD Entity Type"@en ;
    rdfs:comment "Schema-compatible name for entity type. RDF-native models may use ord:EntityType as the generic class."@en ;
    rdfs:isDefinedBy ord: .

ord:RelatedEntityType
    a rdfs:Class ;
    rdfs:subClassOf ord:EntityType ;
    rdfs:label "Related Entity Type"@en ;
    rdfs:comment "Entity type related to another entity type or resource."@en ;
    rdfs:isDefinedBy ord: .

ord:ExposedEntityType
    a rdfs:Class ;
    rdfs:subClassOf ord:EntityType ;
    rdfs:label "Exposed Entity Type"@en ;
    rdfs:comment "Entity type exposed by an API or event resource."@en ;
    rdfs:isDefinedBy ord: .

ord:EntityTypeMapping
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Entity Type Mapping"@en ;
    rdfs:comment "Mapping between API models and conceptual entity types."@en ;
    rdfs:isDefinedBy ord: .

ord:ApiModelSelector
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "API Model Selector"@en ;
    rdfs:comment "Selector used to select a model within an API resource."@en ;
    rdfs:isDefinedBy ord: .

ord:OdataApiModelSelector
    a rdfs:Class ;
    rdfs:subClassOf ord:ApiModelSelector ;
    rdfs:label "OData API Model Selector"@en ;
    rdfs:comment "API model selector for OData resources."@en ;
    rdfs:isDefinedBy ord: .

ord:JsonPointerApiModelSelector
    a rdfs:Class ;
    rdfs:subClassOf ord:ApiModelSelector ;
    rdfs:label "JSON Pointer API Model Selector"@en ;
    rdfs:comment "API model selector based on JSON Pointer."@en ;
    rdfs:isDefinedBy ord: .

ord:ApiResourceDefinition
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResourceDefinition ;
    rdfs:label "API Resource Definition"@en ;
    rdfs:comment "Machine-readable API resource definition."@en ;
    rdfs:isDefinedBy ord: .

ord:EventResourceDefinition
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResourceDefinition ;
    rdfs:label "Event Resource Definition"@en ;
    rdfs:comment "Machine-readable event resource definition."@en ;
    rdfs:isDefinedBy ord: .

ord:DataProductDefinition
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResourceDefinition ;
    rdfs:label "Data Product Definition"@en ;
    rdfs:comment "Machine-readable data product definition."@en ;
    rdfs:isDefinedBy ord: .

ord:CapabilityDefinition
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResourceDefinition ;
    rdfs:label "Capability Definition"@en ;
    rdfs:comment "Machine-readable capability definition."@en ;
    rdfs:isDefinedBy ord: .

ord:EntityTypeDefinition
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResourceDefinition ;
    rdfs:label "Entity Type Definition"@en ;
    rdfs:comment "Machine-readable entity type definition."@en ;
    rdfs:isDefinedBy ord: .

ord:OverlayDefinition
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDResourceDefinition ;
    rdfs:label "Overlay Definition"@en ;
    rdfs:comment "Machine-readable ORD overlay document definition. Required properties are type, media type, and URL."@en ;
    ord:introducedInVersion "1.15.0" ;
    ord:featureStatus "alpha" ;
    rdfs:isDefinedBy ord: .

ord:DocumentationLabel
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Documentation Label"@en ;
    rdfs:comment "Label used to classify or identify documentation."@en ;
    rdfs:isDefinedBy ord: .

ord:ExtensionInformation
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Extension Information"@en ;
    rdfs:comment "Information about the extensibility of a resource."@en ;
    rdfs:isDefinedBy ord: .

ord:Extensible
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Extensible"@en ;
    rdfs:comment "Supporting object describing extension-related information."@en ;
    rdfs:isDefinedBy ord: .

ord:ConsumptionBundle
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Consumption Bundle"@en ;
    rdfs:comment "A collection of resources grouped together for consumption."@en ;
    rdfs:isDefinedBy ord: .

ord:ConsumptionBundleReference
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Consumption Bundle Reference"@en ;
    rdfs:comment "Reference to a consumption bundle."@en ;
    rdfs:isDefinedBy ord: .

ord:CredentialExchangeStrategy
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Credential Exchange Strategy"@en ;
    rdfs:comment "Strategy used for exchanging credentials in an ORD consumption context."@en ;
    rdfs:isDefinedBy ord: .

ord:IntegrationAspect
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Integration Aspect"@en ;
    rdfs:comment "Aspect that contributes to an integration dependency or integration scenario."@en ;
    rdfs:isDefinedBy ord: .

ord:CapabilityIntegrationAspect
    a rdfs:Class ;
    rdfs:subClassOf ord:IntegrationAspect ;
    rdfs:label "Capability Integration Aspect"@en ;
    rdfs:comment "Integration aspect related to a capability."@en ;
    rdfs:isDefinedBy ord: .

ord:ApiCompatibility
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "API Compatibility"@en ;
    rdfs:comment "Declares that an API resource is compatible with an abstract API interface contract."@en ;
    rdfs:isDefinedBy ord: .

ord:EventCompatibility
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Event Compatibility"@en ;
    rdfs:comment "Declares that an event resource is compatible with an abstract event interface contract."@en ;
    rdfs:isDefinedBy ord: .

ord:Tombstone
    a rdfs:Class ;
    rdfs:subClassOf ord:Concept ;
    rdfs:label "Tombstone"@en ;
    rdfs:comment "A tombstone indicates that a previously published ORD resource or taxonomy entity has been removed or decommissioned."@en ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Link Type Classes
# =============================================================================

ord:AuthenticationLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Authentication Link"@en ;
    rdfs:comment "Link to authentication information."@en ;
    rdfs:isDefinedBy ord: .

ord:ApiDocumentationLink
    a rdfs:Class ;
    rdfs:subClassOf ord:ApiEventResourceLink ;
    rdfs:label "API Documentation Link"@en ;
    rdfs:comment "Link to API documentation."@en ;
    rdfs:isDefinedBy ord: .

ord:ClientRegistrationLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Client Registration Link"@en ;
    rdfs:comment "Link to client or application registration."@en ;
    rdfs:isDefinedBy ord: .

ord:ConsoleLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Console Link"@en ;
    rdfs:comment "Link to a management or administration console."@en ;
    rdfs:isDefinedBy ord: .

ord:CustomLink
    a rdfs:Class ;
    rdfs:subClassOf ord:ORDTypedLink ;
    rdfs:label "Custom Link"@en ;
    rdfs:comment "Custom typed link."@en ;
    rdfs:isDefinedBy ord: .

ord:LicenseLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "License Link"@en ;
    rdfs:comment "Link to license information."@en ;
    rdfs:isDefinedBy ord: .

ord:PaymentLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Payment Link"@en ;
    rdfs:comment "Link to payment or billing information."@en ;
    rdfs:isDefinedBy ord: .

ord:SandboxLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Sandbox Link"@en ;
    rdfs:comment "Link to a sandbox or test environment."@en ;
    rdfs:isDefinedBy ord: .

ord:ServiceLevelAgreementLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Service Level Agreement Link"@en ;
    rdfs:comment "Link to a service-level agreement."@en ;
    rdfs:isDefinedBy ord: .

ord:SupportLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Support Link"@en ;
    rdfs:comment "Link to support resources."@en ;
    rdfs:isDefinedBy ord: .

ord:TermsOfUseLink
    a rdfs:Class ;
    rdfs:subClassOf ord:PackageLink ;
    rdfs:label "Terms of Use Link"@en ;
    rdfs:comment "Link to terms of use."@en ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Shared Descriptive and Lifecycle Properties
# =============================================================================

ord:ordId
    a rdf:Property ;
    rdfs:label "ORD ID"@en ;
    rdfs:comment "Stable, globally unique ORD identifier for resources, taxonomy entities, and system-context entities."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:localId
    a rdf:Property ;
    rdfs:label "Local ID"@en ;
    rdfs:comment "Local identifier as known by the described system."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:title
    a rdf:Property ;
    rdfs:label "Title"@en ;
    rdfs:comment "Human-readable title."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:title ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:shortDescription
    a rdf:Property ;
    rdfs:label "Short Description"@en ;
    rdfs:comment "Plain-text short description."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:description
    a rdf:Property ;
    rdfs:label "Description"@en ;
    rdfs:comment "Detailed human-readable description."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:customDescription
    a rdf:Property ;
    rdfs:label "Custom Description"@en ;
    rdfs:comment "Free-text custom description of an ORD entity."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:aiHint
    a rdf:Property ;
    rdfs:label "AI Hint"@en ;
    rdfs:comment "Additional hint intended to support AI-assisted interpretation or discovery."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:version
    a rdf:Property ;
    rdfs:label "Version"@en ;
    rdfs:comment "Complete Semantic Versioning version string."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:hasVersion ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:lastUpdate
    a rdf:Property ;
    rdfs:label "Last Update"@en ;
    rdfs:comment "Recommended date-time indicating when the last change to the resource, including its definitions, happened."@en ;
    rdfs:domain ord:ORDResource ;
    rdfs:range xsd:dateTime ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:releaseStatus
    a rdf:Property ;
    rdfs:label "Release Status"@en ;
    rdfs:comment "Release lifecycle status of an ORD entity."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range skos:Concept ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:visibility
    a rdf:Property ;
    rdfs:label "Visibility"@en ;
    rdfs:comment "Visibility or exposure level of an ORD entity."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range skos:Concept ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:policyLevel
    a rdf:Property ;
    rdfs:label "Policy Level"@en ;
    rdfs:comment "Policy or compliance level that the described ORD document, package, or resource needs to comply with."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range skos:Concept ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:customPolicyLevel
    a rdf:Property ;
    rdfs:label "Custom Policy Level"@en ;
    rdfs:comment "Deprecated since ORD spec v1.9.9. Custom policy level specification identifier. Use ord:policyLevel with a SKOS concept instead."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    ord:deprecated true ;
    ord:deprecatedSinceVersion "1.9.9" ;
    rdfs:isDefinedBy ord: .

ord:tag
    a rdf:Property ;
    rdfs:label "Tag"@en ;
    rdfs:comment "Free-text tag. Character constraints are defined in SHACL."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:country
    a rdf:Property ;
    rdfs:label "Country"@en ;
    rdfs:comment "Country code according to ISO 3166-1 alpha-2. Countries assigned to a package are inherited by contained resources."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:industry
    a rdf:Property ;
    rdfs:label "Industry"@en ;
    rdfs:comment "Industry classification associated with an ORD entity. In normalized RDF, values should be SKOS concepts from ord:IndustryConceptScheme or a compatible extension scheme."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:lineOfBusiness
    a rdf:Property ;
    rdfs:label "Line of Business"@en ;
    rdfs:comment "Line-of-business classification associated with an ORD entity. In normalized RDF, values should be SKOS concepts from ord:LineOfBusinessConceptScheme or a compatible extension scheme."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:removedDate
    a rdf:Property ;
    rdfs:label "Removed Date"@en ;
    rdfs:comment "RFC 3339 date-time on which the ORD resource or taxonomy entity was tombstoned or removed."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy ord: .

ord:sunsetDate
    a rdf:Property ;
    rdfs:label "Sunset Date"@en ;
    rdfs:comment "RFC 3339 date-time indicating when an ORD resource or entity is planned to be sunset."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:dateTime ;
    rdfs:isDefinedBy ord: .

ord:date
    a rdf:Property ;
    rdfs:label "Date"@en ;
    rdfs:comment "Date of a changelog entry."@en ;
    rdfs:domain ord:ChangelogEntry ;
    rdfs:range xsd:date ;
    ord:introducedInVersion "1.0" ;
    rdfs:isDefinedBy ord: .

ord:abstract
    a rdf:Property ;
    rdfs:label "Abstract"@en ;
    rdfs:comment "Indicates that the described resource is abstract or interface-only."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy ord: .

ord:disabled
    a rdf:Property ;
    rdfs:label "Disabled"@en ;
    rdfs:comment "Indicates whether the entity is disabled."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy ord: .

ord:extensible
    a rdf:Property ;
    rdfs:label "Extensible"@en ;
    rdfs:comment "Defines whether the resource's extension information is extensible."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:boolean ;
    rdfs:isDefinedBy ord: .

# =============================================================================
# Relationship Properties
# =============================================================================

ord:related
    a rdf:Property ;
    rdfs:label "Related"@en ;
    rdfs:comment "Relates an ORD entity to another concept or resource."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range rdfs:Resource ;
    rdfs:isDefinedBy ord: .

ord:relationType
    a rdf:Property ;
    rdfs:label "Relation Type"@en ;
    rdfs:comment "Optional semantic type of a relationship."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range skos:Concept ;
    rdfs:isDefinedBy ord: .

ord:relatedOrdId
    a rdf:Property ;
    rdfs:label "Related ORD ID"@en ;
    rdfs:comment "ORD ID of a referenced related resource."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy ord: .

ord:relatedEventResources
    a rdf:Property ;
    rdfs:label "Related Event Resources"@en ;
    rdfs:comment "Typed ORD ID references to related event resources."@en ;
    rdfs:domain ord:ORDEntity ;
    rdfs:range rdfs:Resource ;
    ord:introducedInVersion "1.14.3" ;
